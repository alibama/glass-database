# Copy to .env for local dev (the deploy installer writes its own).
# --- database -------------------------------------------------------------
GLASSDB_PATH=data/glassdb.db
# Point at Turso instead of the local file (also `pip install libsql`):
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# --- API ------------------------------------------------------------------
ROOT_PATH=                       # "/api" when behind the reverse proxy
GLASSDB_ADMIN_TOKEN=change-me    # X-API-Key that unlocks restricted data

# --- contributions --------------------------------------------------------
GLASSDB_MODERATION=1             # 1 = review before public, 0 = publish immediately
PUBLIC_BASE_URL=http://localhost:8501

# --- AIP -> MinIO / S3 (optional; blank = local bags only) ----------------
# MINIO_ENDPOINT=minio.host:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=glassdb-aip
# MINIO_SECURE=1

# --- Discord submission notifications (optional) ---------------------------
# Channel webhook (Server Settings -> Integrations -> Webhooks). New submissions
# post here with one-click approve/reject links signed by GLASSDB_ADMIN_TOKEN.
# DISCORD_WEBHOOK_URL=

# --- site-wide sign-in for the static pages (capture apps, Seasons, graph) ---
# Signing key for session/pairing tokens. Falls back to [auth].cookie_secret in
# .streamlit/secrets.toml, then GLASSDB_ADMIN_TOKEN. Set it explicitly in prod.
# GLASSDB_SESSION_SECRET=
# Local development only: GET /api/auth/dev-login creates a fake signed-in user.
# GLASSDB_DEV_LOGIN=1

# --- local vision model (optional; see docs/GLASS-VISION.md) ----------------
# A local Ollama vision-language model suggests techniques / style traits /
# colour / construction for an object photo, using the registry's closed
# vocabularies ("features, not verdicts" — never a maker or a value). Blank =
# suggestions off; the UI falls back to the fingerprint's own colour/size data.
#   ollama pull qwen2.5vl:7b      (~6 GB; qwen2.5vl:3b for small machines)
# OLLAMA_URL=http://127.0.0.1:11434
# GLASS_VISION_MODEL=qwen2.5vl:7b
