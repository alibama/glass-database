  skos:note "authority mapping pending alignment" .

gdt:aventurine-dec a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Aventurine inclusions"@en ;
  skos:definition "Sparkling aventurine used decoratively."@en ;
