  skos:note "authority mapping pending alignment" .

gdt:rim-plain a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Plain fire-polished rim"@en ;
  skos:definition "Simple rounded fire-polished rim."@en ;
  skos:note "authority mapping pending alignment" .

gdt:rim-everted a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Everted / flared rim"@en ;
  skos:definition "Rim turned outward."@en ;
  skos:note "authority mapping pending alignment" .

gdt:rim-tooled a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Tooled / pinched rim"@en ;
  skos:definition "Rim worked with tools or pincers."@en ;
  skos:note "authority mapping pending alignment" .

gdt:cristallo a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Cristallo"@en ;
  skos:altLabel "colourless"@en ;
  skos:definition "Very pure near-colourless soda glass developed on Murano, imitating rock crystal."@en ;
  rdfs:seeAlso <https://www.cmog.org/glass-dictionary/cristallo> ;
  skos:note "authority mapping pending alignment" .

gdt:vitrum-blancum a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Tinged 'green' metal"@en ;
  skos:altLabel "verre de fougère"@en ;
  skos:altLabel "fern glass"@en ;
  skos:definition "Slightly greenish/greyish or smoky metal (e.g. fern-ash verre de fougère)."@en ;
  skos:note "authority mapping pending alignment" .

gdt:calcedonio a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Calcedonio"@en ;
  skos:altLabel "chalcedony glass"@en ;
  skos:definition "Marbled opaque glass imitating chalcedony/agate."@en ;
  skos:note "authority mapping pending alignment" .

gdt:lattimo a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Lattimo (opaque white)"@en ;
  skos:altLabel "milk glass"@en ;
  skos:definition "Opaque white glass, used as a body or as threads."@en ;
  skos:note "authority mapping pending alignment" .

gdt:coloured-cobalt a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Cobalt-blue metal"@en ;
  skos:altLabel "blue"@en ;
  skos:definition "Deep blue body or trails from cobalt."@en ;
  skos:note "authority mapping pending alignment" .

gdt:coloured-manganese a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Manganese-purple metal"@en ;
  skos:definition "Purple/amethyst body from manganese."@en ;
  skos:note "authority mapping pending alignment" .

gdt:aventurine-metal a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Aventurine metal"@en ;
  skos:altLabel "avventurina"@en ;
  skos:definition "Glass with sparkling copper crystals."@en ;
  skos:note "authority mapping pending alignment" .

gdt:filigrana a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Filigrana (canework)"@en ;
  skos:altLabel "filigree glass"@en ;
  skos:altLabel "latticino"@en ;
  skos:altLabel "latticinio"@en ;
  skos:definition "Decoration using white or coloured glass canes/threads embedded in clear glass."@en ;
