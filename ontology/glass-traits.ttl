@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gdt:  <https://glassdatabase.org/vocab/glass-traits#> .
@prefix aat:  <http://vocab.getty.edu/aat/> .
@prefix wd:   <http://www.wikidata.org/entity/> .

<https://glassdatabase.org/vocab/glass-traits> a skos:ConceptScheme ;
  dct:title "Glass Database — Venetian & façon-de-Venise trait thesaurus" ;
  dct:description "Observable style traits of Renaissance Venetian-style drinking glasses. Traits describe features, not attributions." ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> .

gdt:facet-form a skos:Collection ;
  skos:prefLabel "Vessel form" ;
  skos:definition "Overall type of the drinking vessel." ;
  skos:member gdt:goblet, gdt:tazza, gdt:flute, gdt:beaker, gdt:tumbler, gdt:ewer .

gdt:facet-bowl a skos:Collection ;
  skos:prefLabel "Bowl form" ;
  skos:definition "Shape of the cup/bowl." ;
  skos:member gdt:bowl-round-funnel, gdt:bowl-conical, gdt:bowl-bucket, gdt:bowl-bell, gdt:bowl-ovoid, gdt:bowl-thistle, gdt:bowl-cup .

gdt:facet-stem a skos:Collection ;
  skos:prefLabel "Stem type" ;
  skos:definition "Construction and form of the stem — the most diagnostic feature." ;
  skos:member gdt:stem-hollow-blown, gdt:stem-solid-drawn, gdt:stem-baluster, gdt:stem-inverted-baluster, gdt:stem-knopped, gdt:stem-ribbed-knop, gdt:stem-figured, gdt:stem-serpent, gdt:stem-winged, gdt:stem-hollow-quatrefoil, gdt:stem-cigar .

gdt:facet-knop a skos:Collection ;
  skos:prefLabel "Knop / collar" ;
  skos:definition "Knops, mereses and collars along the stem." ;
  skos:member gdt:merese, gdt:knop-hollow, gdt:knop-solid, gdt:knop-cushion, gdt:knop-acorn .

gdt:facet-foot a skos:Collection ;
  skos:prefLabel "Foot & pontil" ;
  skos:definition "Foot construction and pontil treatment." ;
  skos:member gdt:foot-folded, gdt:foot-conical, gdt:foot-domed, gdt:foot-spreading, gdt:pontil-rough, gdt:pontil-ground .

gdt:facet-rim a skos:Collection ;
  skos:prefLabel "Rim" ;
  skos:definition "Finishing of the rim." ;
  skos:member gdt:rim-folded-in, gdt:rim-folded-out, gdt:rim-plain, gdt:rim-everted, gdt:rim-tooled .

gdt:facet-metal a skos:Collection ;
  skos:prefLabel "Metal / body glass" ;
  skos:definition "The glass itself — colour and composition family." ;
  skos:member gdt:cristallo, gdt:vitrum-blancum, gdt:calcedonio, gdt:lattimo, gdt:coloured-cobalt, gdt:coloured-manganese, gdt:aventurine-metal .

gdt:facet-filigrana a skos:Collection ;
  skos:prefLabel "Filigrana decoration" ;
  skos:definition "White/coloured thread (canework) decoration families." ;
  skos:member gdt:filigrana, gdt:vetro-a-fili, gdt:vetro-a-retortoli, gdt:vetro-a-reticello, gdt:zanfirico .

gdt:facet-decoration a skos:Collection ;
  skos:prefLabel "Other decoration" ;
  skos:definition "Surface and applied decoration beyond filigrana." ;
  skos:member gdt:mould-ribbing, gdt:wrythen, gdt:ice-glass, gdt:diamond-point, gdt:gilding, gdt:cold-enamel, gdt:applied-trails, gdt:prunts, gdt:pincered-work, gdt:aventurine-dec .

gdt:facet-evidence a skos:Collection ;
  skos:prefLabel "Making evidence & condition" ;
  skos:definition "Tooling, wear, and condition features (for study/attribution)." ;
  skos:member gdt:tool-marks, gdt:straw-marks, gdt:wear-ring, gdt:mould-seams, gdt:internal-bubbles, gdt:weathering, gdt:devitrification, gdt:repair .

gdt:goblet a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Goblet"@en ;
  skos:altLabel "calice"@en ;
  skos:definition "Stemmed drinking vessel with a bowl on a footed stem."@en ;
  skos:note "authority mapping pending alignment" .

gdt:tazza a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Tazza"@en ;
  skos:definition "Shallow wide bowl on a stemmed foot; a display/drinking form."@en ;
  skos:note "authority mapping pending alignment" .

gdt:flute a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Flute"@en ;
  skos:definition "Tall narrow bowl for sparkling or ceremonial drinking."@en ;
  skos:note "authority mapping pending alignment" .

gdt:beaker a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Beaker"@en ;
  skos:altLabel "bicchiere"@en ;
  skos:definition "Footless or low-footed tumbler form."@en ;
  skos:note "authority mapping pending alignment" .

gdt:tumbler a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Tumbler"@en ;
  skos:definition "Flat-based drinking vessel without a stem."@en ;
  skos:note "authority mapping pending alignment" .

gdt:ewer a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Ewer / jug"@en ;
  skos:definition "Pouring vessel with handle and spout."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-round-funnel a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Round-funnel bowl"@en ;
  skos:definition "Rounded base opening into a funnel."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-conical a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Conical bowl"@en ;
  skos:definition "Straight-sided cone."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-bucket a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Bucket bowl"@en ;
  skos:definition "Cylindrical, flat-based bowl."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-bell a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Bell bowl"@en ;
  skos:definition "Bell-shaped, flaring to the rim."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-ovoid a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Ovoid bowl"@en ;
  skos:definition "Egg-shaped bowl."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-thistle a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Thistle bowl"@en ;
  skos:definition "Bulbous base with a flaring upper section."@en ;
  skos:note "authority mapping pending alignment" .

gdt:bowl-cup a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Cup-shaped bowl"@en ;
  skos:definition "Shallow rounded cup."@en ;
  skos:note "authority mapping pending alignment" .

gdt:stem-hollow-blown a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Hollow blown stem"@en ;
  skos:definition "Stem blown as a hollow form, often moulded."@en ;
  skos:note "authority mapping pending alignment" .

gdt:stem-solid-drawn a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Solid drawn stem"@en ;
  skos:definition "Solid stem drawn from the bowl or foot gather."@en ;
  skos:note "authority mapping pending alignment" .

gdt:stem-baluster a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Baluster stem"@en ;
  skos:definition "Vase-profile swelling stem."@en ;
  skos:note "authority mapping pending alignment" .

gdt:stem-inverted-baluster a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Inverted baluster stem"@en ;
  skos:definition "Baluster with the swelling uppermost."@en ;
  skos:note "authority mapping pending alignment" .

gdt:stem-knopped a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Knopped stem"@en ;
  skos:definition "Stem articulated by one or more knops."@en ;
