  skos:note "authority mapping pending alignment" .

gdt:merese a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Merese"@en ;
  skos:altLabel "wafer"@en ;
  skos:altLabel "collar"@en ;
  skos:definition "Flat glass wafer/collar joining bowl, stem, and foot."@en ;
  skos:note "authority mapping pending alignment" .

gdt:knop-hollow a skos:Concept ;
