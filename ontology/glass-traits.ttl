gdt:stem-serpent a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Serpent stem"@en ;
  skos:altLabel "à serpent"@en ;
  skos:altLabel "vetro a serpenti"@en ;
