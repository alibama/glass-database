  skos:note "authority mapping pending alignment" .

gdt:diamond-point a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Diamond-point engraving"@en ;
  skos:altLabel "diamond engraving"@en ;
  skos:definition "Surface scratched with a diamond point."@en ;
  skos:note "authority mapping pending alignment" .

gdt:gilding a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Gilding"@en ;
  skos:definition "Applied gold decoration."@en ;
  skos:note "authority mapping pending alignment" .

gdt:cold-enamel a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Enamel / cold painting"@en ;
  skos:altLabel "smalti"@en ;
  skos:altLabel "enamelled"@en ;
  skos:definition "Painted enamels (smalti), fired or cold."@en ;
  skos:note "authority mapping pending alignment" .

gdt:applied-trails a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Applied trails"@en ;
  skos:altLabel "trailing"@en ;
  skos:definition "Threads of glass trailed onto the surface."@en ;
  skos:note "authority mapping pending alignment" .

gdt:prunts a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Prunts / raspberry prunts"@en ;
  skos:altLabel "raspberry prunt"@en ;
  skos:definition "Applied blobs, often stamped (raspberry)."@en ;
  skos:note "authority mapping pending alignment" .

gdt:pincered-work a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Pincered work"@en ;
  skos:altLabel "waffles"@en ;
  skos:altLabel "pincered trails"@en ;
