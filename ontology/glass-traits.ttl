gdt:stem-ribbed-knop a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Mould-blown ribbed knop stem"@en ;
  skos:altLabel "melon knop"@en ;
  skos:altLabel "pumpkin knop"@en ;
  skos:definition "Hollow knop blown in a ribbed mould (the 'flattened pumpkin/melon' knop)."@en ;
  skos:note "authority mapping pending alignment" .

gdt:stem-figured a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Figured / pincered stem"@en ;
  skos:altLabel "mereses stem"@en ;
  skos:definition "Stem worked with pincers into figural or moulded forms (lion masks, etc.)."@en ;
