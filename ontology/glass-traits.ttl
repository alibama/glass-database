  skos:prefLabel "Vetro a fili"@en ;
  skos:altLabel "a fili"@en ;
  skos:altLabel "thread glass"@en ;
  skos:definition "Parallel straight threads/canes."@en ;
  skos:note "authority mapping pending alignment" .

gdt:vetro-a-retortoli a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Vetro a retortoli"@en ;
  skos:altLabel "a retortoli"@en ;
  skos:altLabel "latticino twist"@en ;
  skos:definition "Twisted cable canes (spiralled threads)."@en ;
  skos:note "authority mapping pending alignment" .

gdt:vetro-a-reticello a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Vetro a reticello"@en ;
  skos:altLabel "reticello"@en ;
  skos:altLabel "net glass"@en ;
  skos:definition "Crosshatched 'little net' of canes with a regular grid of trapped air bubbles."@en ;
  rdfs:seeAlso <https://www.cmog.org/glass-dictionary/reticello> ;
  skos:note "authority mapping pending alignment" .

gdt:zanfirico a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Zanfirico"@en ;
  skos:altLabel "zanfirico canes"@en ;
  skos:definition "Later term for twisted-cane (a retortoli–type) filigrana rods."@en ;
  skos:note "authority mapping pending alignment" .

gdt:mould-ribbing a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Mould-blown ribbing"@en ;
  skos:altLabel "optic ribbing"@en ;
  skos:definition "Vertical ribs from an optic/dip mould."@en ;
  skos:note "authority mapping pending alignment" .

gdt:wrythen a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Wrythen / twisted ribbing"@en ;
  skos:altLabel "wrything"@en ;
  skos:definition "Ribs twisted into a spiral."@en ;
  skos:note "authority mapping pending alignment" .

gdt:ice-glass a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Ice glass (ghiaccio)"@en ;
  skos:altLabel "ghiaccio"@en ;
  skos:altLabel "craquelle"@en ;
  skos:altLabel "crackle glass"@en ;
