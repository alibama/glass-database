  skos:note "authority mapping pending alignment" .

gdt:knop-cushion a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Cushion knop"@en ;
  skos:definition "Flattened cushion-shaped knop."@en ;
  skos:note "authority mapping pending alignment" .

gdt:knop-acorn a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Acorn knop"@en ;
  skos:definition "Acorn-shaped knop."@en ;
  skos:note "authority mapping pending alignment" .

gdt:foot-folded a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Folded foot"@en ;
  skos:altLabel "folded conical foot"@en ;
  skos:definition "Foot rim folded under for strength."@en ;
  skos:note "authority mapping pending alignment" .

gdt:foot-conical a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Conical foot"@en ;
  skos:definition "Cone-shaped spreading foot."@en ;
  skos:note "authority mapping pending alignment" .

gdt:foot-domed a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Domed foot"@en ;
  skos:definition "Raised domed foot."@en ;
  skos:note "authority mapping pending alignment" .

gdt:foot-spreading a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Spreading foot"@en ;
  skos:definition "Wide low spreading foot."@en ;
  skos:note "authority mapping pending alignment" .

gdt:pontil-rough a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Rough pontil scar"@en ;
  skos:altLabel "pontil mark"@en ;
  skos:definition "Unfinished pontil scar on the foot underside."@en ;
  skos:note "authority mapping pending alignment" .

gdt:pontil-ground a skos:Concept ;
  skos:inScheme <https://glassdatabase.org/vocab/glass-traits> ;
  skos:prefLabel "Ground/polished pontil"@en ;
