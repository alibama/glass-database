      }
    },
    {
      "@id": "gbo:Colorant",
      "@type": "owl:Class",
      "gbo:vocabularyTarget": {
        "@language": "en",
        "@value": "Getty AAT (colorants); Wikidata"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "colorant"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:RawMaterial"
      },
      "skos:definition": {
        "@language": "en",
