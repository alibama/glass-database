      },
      "rdfs:subClassOf": {
        "@id": "gbo:Tradition"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Lead crystal (Ravenscroft, 1670s) prized for weight and brilliance; the gaffer/chair/servitor/gatherer/taker-in team lexicon; cut glass."
      }
    },
    {
