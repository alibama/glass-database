      }
    },
    {
      "@id": "gbo:",
      "@type": "owl:Ontology",
      "dcterms:contributor": {
        "@language": "en",
        "@value": "Drafted with Claude (Anthropic)"
      },
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2026-08-28"
      },
      "dcterms:creator": {
        "@language": "en",
        "@value": "Anson Parker"
      },
      "dcterms:description": {
        "@language": "en",
        "@value": "A craft-and-dialect ontology for hot glass: the material's life from batch\nthrough melting, gathering, hot forming, decoration, mould forming, kiln work,\nannealing and cold working, plus studio roles, defects, regional traditions and a\nqueryable dialect concordance. It is the artisanal/technique layer that bridges two\nexisting efforts: the GlasDigital materials-science ontology (physics, melting,\nmeasurement) which it aligns physical properties and equipment to, and the\nevent-centric cultural-heritage modelling of De Boer et al. (CIDOC-CRM / AAT /\nWikidata) which it mirrors for describing individual works and their creation."
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "A Glassblowing Ontology (craft, process & dialect layer)"
      },
      "owl:versionInfo": "0.1.0",
      "rdfs:seeAlso": [
        {
          "@id": "https://w3id.org/pmd/glass-ontology/1.0.1"
        },
        {
          "@id": "https://materialdigital.github.io/glasdigital-ontology/index-en.html"
        },
        {
          "@id": "https://journal.dhbenelux.org/journal/issues/004/article-4-DeBoer.html"
        }
      ]
    },
    {
      "@id": "gbo:createdBy",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "gbo:Artifact"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "created by"
      },
      "rdfs:range": {
        "@id": "gbo:CreationEvent"
      },
      "rdfs:seeAlso": {
        "@id": "crm:P108i_was_produced_by"
      }
    },
    {
      "@id": "gbo:MeltingProcess",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "melting process"
      },
      "rdfs:seeAlso": {
        "@id": "glasdigi:GlassManufacturingProcess"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:Process"
      },
      "skos:closeMatch": {
        "@id": "glasdigi:meltingProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Turning raw batch into homogeneous workable glass."
      }
    },
    {
      "@id": "gbo:WorkingRange",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "working range"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:ThermalProperty"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The viscosity band soft enough to shape but stiff enough to hold form. Wide = 'long' glass; narrow = 'short' glass."
      }
    },
    {
      "@id": "gbo:Blocks",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "blocks"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:HandTool"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Wet cupped fruitwood tools for centring and rounding the gather; water flashes to steam and floats the glass."
      }
    },
    {
      "@id": "gbo:DecorativeCutting",
      "@type": "owl:Class",
      "gbo:originatesIn": {
        "@id": "gbo:BohemianTradition"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "decorative cutting"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:ColdWorkingProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The lapidary tradition of mitre, panel and brilliant cuts on a cutting lathe; the Bohemian heartland."
      }
    },
    {
      "@id": "gbo:GloryHole",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "glory hole"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:HeatingEquipment"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A reheating chamber; work is spun in it to stay hot and mobile between tooling steps."
      }
    },
    {
      "@id": "gbo:Slumping",
      "@type": "owl:Class",
      "gbo:vocabularyTarget": {
        "@language": "en",
        "@value": "Getty AAT (slumping); Wikidata"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "slumping"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:KilnProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fused blank sags over or into a mould to take a form."
      }
    },
    {
      "@id": "gbo:Blister",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "blister"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:Defect"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A large bubble from gas release, over-reheat or a wet tool."
      }
    },
    {
      "@id": "gbo:Incalmo",
      "@type": "owl:Class",
      "gbo:originatesIn": {
        "@id": "gbo:MuraneseTradition"
      },
      "gbo:originatesInHint": {
        "@language": "en",
        "@value": "Venetian / Muranese"
      },
      "rdfs:label": {
        "@language": "it",
        "@value": "incalmo"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:HotFormingProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Fusing two or more separately blown, open-mouthed forms rim-to-rim while hot to make crisp colour bands; demands matched diameters."
      }
    },
    {
      "@id": "gbo:Marvering",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "marvering"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:HotFormingProcess"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Rolling the gather on the marver to shape, cool or pick up colour."
      }
    },
    {
      "@id": "gbo:Conditioning",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "conditioning"
      },
      "rdfs:subClassOf": {
        "@id": "gbo:MeltingProcess"
      },
      "skos:altLabel": {
        "@language": "en",
        "@value": "plaining"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Evening temperature and homogenising the glass before gathering."
      }
    },
