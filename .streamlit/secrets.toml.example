# Copy to .streamlit/secrets.toml to ENABLE per-user login for Glowtbook.
# While this file is absent (or has no [auth]), Glowtbook runs as a shared demo
# and the other apps are unaffected. Streamlit >= 1.42 + Authlib required.
#
#  chmod 600 .streamlit/secrets.toml   # it holds a client secret
#  sudo systemctl restart glassdb-glowtbook

# ---- Option A: Google directly (fastest; covers most users) ----------------
# In Google Cloud Console create an OAuth 2.0 Client (type: Web application) and
# add this exact Authorized redirect URI:
#     https://glassdatabase.org/glowtbook/oauth2callback
#
# [auth]
# redirect_uri = "https://glassdatabase.org/glowtbook/oauth2callback"
# cookie_secret = "REPLACE_WITH_RANDOM_32_BYTES"          # openssl rand -base64 32
#
# [auth.google]
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "xxxxxxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Option B: a broker (Auth0 / Keycloak / Authentik / Logto) -------------
# One OIDC client that fans out to Google, Facebook, Apple, Bluesky, etc.
# Streamlit code doesn't change — just this config.
#
# [auth]
# redirect_uri = "https://glassdatabase.org/glowtbook/oauth2callback"
# cookie_secret = "REPLACE_WITH_RANDOM_32_BYTES"
#
# [auth.social]
# client_id = "xxx"
# client_secret = "xxx"
# server_metadata_url = "https://YOUR-BROKER/.well-known/openid-configuration"
