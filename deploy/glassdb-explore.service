[Unit]
Description=Glass Database explore (Streamlit)
After=network.target

[Service]
Type=simple
User=glassdb
Group=glassdb
WorkingDirectory=/opt/glassdatabase
EnvironmentFile=/opt/glassdatabase/.env
Environment=HOME=/opt/glassdatabase
ExecStart=/opt/glassdatabase/.venv/bin/streamlit run explore/app.py \
    --server.port 8502 --server.address 127.0.0.1 \
    --server.baseUrlPath explore \
    --server.headless true \
    --server.enableCORS false \
    --browser.gatherUsageStats false
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
