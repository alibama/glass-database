[Unit]
Description=Glass Database API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=glassdb
Group=glassdb
WorkingDirectory=/opt/glassdatabase
EnvironmentFile=/opt/glassdatabase/.env
ExecStart=/opt/glassdatabase/.venv/bin/uvicorn api.main:app \
    --host 127.0.0.1 --port 8000 --workers 2 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
# modest hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
